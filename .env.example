# Big Data Final Project - Environment Configuration Template
# Copy this file to .env and adjust as necessary for your environment

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=bigdata_orders_db

# Collection Names
COLLECTION_RAW=orders_raw
COLLECTION_VALIDATED=orders_validated
COLLECTION_QUARANTINE=orders_quarantine
COLLECTION_MV_DAILY_SALES=daily_sales_summary
COLLECTION_MV_TOP_PRODUCTS=top_products_summary
COLLECTION_JOB_LOGS=job_execution_logs
COLLECTION_MV_METADATA=mv_refresh_metadata

# Pipeline Ingestion Thresholds
SMALL_FILE_THRESHOLD_MB=200.0
BATCH_SIZE=5000

# Apache PySpark Configuration
SPARK_APP_NAME=HybridOrdersPipeline
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
